{%- render 'tejori-assets' -%}

{%- liquid
  if section.settings.collection != blank
    assign items = section.settings.collection.products
    assign view_all = section.settings.collection.url
  else
    assign items = collections.all.products
    assign view_all = routes.all_products_collection_url
  endif
-%}

<section id="shop" class="tj tj-products tj-stage" style="--tj-card-bg: {{ section.settings.card_color }};">
  {%- if section.settings.show_mark -%}
    <span class="tj-products__mark" aria-hidden="true">{{ section.settings.mark_text | default: shop.name | escape }}</span>
  {%- endif -%}

  <div class="tj-container">
    <div class="tj-products__head tj-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="tj-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="tj-heading">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="tj-products__list tj-scroller">
      {%- for product in items limit: section.settings.limit -%}
        <div class="tj-reveal" style="--d: {{ forloop.index0 | modulo: 3 | times: 90 }}ms;">
          {%- render 'tejori-product-card', product: product -%}
        </div>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div>
            <article class="tj-card">
              <span class="tj-card__media">{{ 'product-1' | placeholder_svg_tag: 'tj-card__img tj-placeholder' }}</span>
              <h3 class="tj-card__title">Choose a collection</h3>
              <p class="tj-card__size">&nbsp;</p>
              <div class="tj-card__buy"><p class="tj-card__price">—</p></div>
              <p class="tj-card__compare">&nbsp;</p>
            </article>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="tj-products__cta"><a href="{{ view_all }}" class="tj-btn">{{ section.settings.view_all_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tejori products",
  "tag": "div",
  "class": "tejori-products-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Products are pulled from this collection. Empty = all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "color", "id": "card_color", "label": "Card colour", "default": "#dce0c5", "info": "Use the same colour as your packshot backgrounds (or transparent PNGs)." },
    { "type": "checkbox", "id": "show_mark", "label": "Show faded wordmark", "default": true },
    { "type": "text", "id": "mark_text", "label": "Wordmark text", "default": "Tejori" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": false },
    { "type": "text", "id": "view_all_label", "label": "'View all' label", "default": "View all products" }
  ],
  "presets": [{ "name": "Tejori products", "category": "Tejori" }]
}
{% endschema %}
