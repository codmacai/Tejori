{%- render 'tejori-assets' -%}

{%- liquid
  assign img = section.settings.image
  if img == blank and product
    assign img = product.media[1] | default: product.featured_media
  endif
-%}

<section class="tj tj-section tj-pad-top">
  <div class="tj-container tj-how__grid">
    <div class="tj-how__media tj-reveal">
      {%- if img != blank -%}
        {{ img | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'tj-placeholder' }}
      {%- endif -%}
    </div>
    <div>
      <div class="tj-reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="tj-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="tj-heading" style="margin-top:16px">{{ section.settings.heading | escape }}</h2>
      </div>
      <ol class="tj-how__steps">
        {%- for block in section.blocks -%}
          <li class="tj-how__step tj-reveal" style="--d: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
            <span class="tj-how__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </span>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tejori how to use",
  "tag": "div",
  "class": "tejori-how-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How to use" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three simple steps" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional — defaults to the product's second image." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Apply" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Part your hair and apply the oil directly to the scalp." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tejori how to use",
      "category": "Tejori",
      "blocks": [
        { "type": "step", "settings": { "title": "Apply", "text": "Part your hair and apply the oil directly to the scalp with the comb applicator." } },
        { "type": "step", "settings": { "title": "Massage", "text": "Massage gently with your fingertips for 3–5 minutes to work it through the roots." } },
        { "type": "step", "settings": { "title": "Leave & wash", "text": "Leave on for at least an hour, or overnight, then wash with the Anti-Dandruff Shampoo." } }
      ]
    }
  ]
}
{% endschema %}
