{%- render 'tejori-assets' -%}

<section id="concerns" class="tj tj-section tj-pad">
  <div class="tj-container">
    <div class="tj-head tj-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="tj-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="tj-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <div class="tj-concerns__grid" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign link = block.settings.link
          if link == blank and block.settings.collection != blank
            assign link = block.settings.collection.url
          endif
          if link == blank
            assign link = routes.all_products_collection_url
          endif
          assign delay = forloop.index0 | times: 90
        -%}
        <a href="{{ link }}" class="tj-concern tj-reveal" style="--d: {{ delay }}ms;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1200', sizes: '(min-width: 750px) 33vw, 100vw', class: 'tj-concern__img', loading: 'lazy', alt: block.settings.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'tj-concern__img tj-placeholder' }}
          {%- endif -%}
          <span class="tj-concern__shade" aria-hidden="true"></span>
          <span class="tj-concern__body">
            <span>
              <span class="tj-concern__title" style="display:block">{{ block.settings.title | escape }}</span>
              {%- if block.settings.subtitle != blank -%}<span class="tj-concern__sub" style="display:block">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
            </span>
            <span class="tj-concern__arrow">{%- render 'tejori-icon', name: 'arrow' -%}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tejori shop by concern",
  "tag": "div",
  "class": "tejori-concerns-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by concern" }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Hair growth" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Neelayamari Hair Oil" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link", "info": "Overrides the collection link — e.g. link straight to a product." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tejori shop by concern",
      "category": "Tejori",
      "blocks": [
        { "type": "concern", "settings": { "title": "Hair growth", "subtitle": "Neelayamari Hair Oil" } },
        { "type": "concern", "settings": { "title": "Anti dandruff", "subtitle": "Anti-Dandruff Combo" } },
        { "type": "concern", "settings": { "title": "Dry hair", "subtitle": "Neelayamari Hair Oil" } }
      ]
    }
  ]
}
{% endschema %}
