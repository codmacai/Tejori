{%- comment -%}
  Usage: {% render 'tejori-icon', name: 'bag' %}
  UI icons are 24px line icons; brand icons (science, derm, cruelty) are hairline 96px illustrations.
{%- endcomment -%}
{%- case name -%}
  {%- when 'bag' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'search' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
  {%- when 'user' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
  {%- when 'menu' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
  {%- when 'close' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'arrow' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
  {%- when 'arrow-left' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"/><path d="m11 6-6 6 6 6"/></svg>
  {%- when 'plus' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/></svg>
  {%- when 'check' -%}
    <svg class="tj-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- when 'star' -%}
    <svg class="tj-icon tj-icon--fill" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5 12.6 7l6 .6-4.5 4 1.3 5.9L10 14.6l-5.4 2.9L5.9 11.6 1.4 7.6l6-.6L10 1.5Z"/></svg>
  {%- when 'science' -%}
    <svg class="tj-brand-icon" viewBox="0 0 96 96" aria-hidden="true">
      <path d="M30 82 H 66 A 6 6 0 0 0 71 73 L 56 46 V 26 H 40 V 46 L 25 73 A 6 6 0 0 0 30 82 Z"/>
      <path class="tj-tint" d="M33 64 C 40 60, 46 68, 52 64 S 61 60, 64 64 L 70 74 A 4 4 0 0 1 66 79 H 30 A 4 4 0 0 1 26 74 Z"/>
      <path d="M33 64 C 40 60, 46 68, 52 64 S 61 60, 64 64"/><path d="M37 26 H 59"/><path d="M48 26 V 12"/>
      <path class="tj-tint-stroke" d="M48 18 C 52 12, 58 10, 64 11 C 63 17, 57 21, 48 18 Z"/>
      <circle cx="42" cy="73" r="2"/><circle cx="54" cy="71" r="1.4"/>
    </svg>
  {%- when 'derm' -%}
    <svg class="tj-brand-icon" viewBox="0 0 96 96" aria-hidden="true">
      <circle class="tj-tint-stroke" cx="42" cy="44" r="25"/><path d="M60 62 L 80 82" style="stroke-width:3.5"/>
      <path d="M24 40 C 32 36, 38 44, 46 40 S 56 36, 60 40"/><path d="M22 49 C 30 45, 38 53, 46 49 S 56 45, 62 49"/><path d="M26 58 C 33 55, 39 61, 46 58 S 54 55, 58 58"/>
      <circle cx="72" cy="22" r="10"/><path d="M67 22 L 71 26 L 78 18"/>
    </svg>
  {%- when 'cruelty' -%}
    <svg class="tj-brand-icon" viewBox="0 0 96 96" aria-hidden="true">
      <path d="M40 40 C 34 30, 33 16, 38 12 C 43 10, 46 24, 46 37"/><path d="M56 40 C 62 30, 63 16, 58 12 C 53 10, 50 24, 50 37"/>
      <path d="M40 34 C 38 26, 38 20, 39 17"/><path d="M56 34 C 58 26, 58 20, 57 17"/>
      <path d="M48 37 C 34 37, 28 46, 28 56 C 28 67, 37 74, 48 74 C 59 74, 68 67, 68 56 C 68 46, 62 37, 48 37 Z"/>
      <circle class="tj-dot" cx="40" cy="54" r="1.8"/><circle class="tj-dot" cx="56" cy="54" r="1.8"/>
      <path d="M46 61 L 48 63 L 50 61"/><path d="M48 63 V 66"/>
      <path d="M70 80 C 72 72, 78 68, 86 68 C 85 76, 79 80, 70 80 Z"/><path d="M70 80 L 79 73"/>
    </svg>
  {%- when 'leaf' -%}
    <svg class="tj-brand-icon" viewBox="0 0 96 96" aria-hidden="true">
      <path d="M48 86 C 22 70, 20 36, 48 10 C 76 36, 74 70, 48 86 Z"/><path d="M48 86 V 30"/><path d="M48 50 L 36 40 M48 62 L 60 52 M48 72 L 38 64"/>
    </svg>
{%- endcase -%}
