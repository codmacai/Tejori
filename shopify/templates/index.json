    "faq": {
      "type": "tejori-faq",
      "blocks": {
        "q-1": {
          "type": "question",
          "settings": {
            "question": "What is Neelayamari?",
            "answer": "<p>Neelayamari (Indigofera tinctoria) is a herb long used in traditional Kerala hair oils. We combine it with coconut and other botanicals to nourish the scalp and roots.</p>"
          }
        },
        "q-2": {
          "type": "question",
          "settings": {
            "question": "How often should I use the hair oil?",
            "answer": "<p>Two to three times a week works well for most people. Massage it into the scalp and leave it on for at least an hour, or overnight, before washing with the Anti-Dandruff Shampoo.</p>"
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "question": "Is it suitable for my hair type?",
            "answer": "<p>Yes — both the hair oil and shampoo are made for all hair types, from straight to curly.</p>"
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "question": "Can I use the shampoo every day?",
            "answer": "<p>The shampoo is gentle enough for regular use. If your scalp is prone to flakes, use it consistently for a few weeks to see the best results.</p>"
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "question": "What’s in the Anti-Dandruff Combo?",
            "answer": "<p>One Neelayamari Hair Oil (200 ml) and one Neelayamari Anti-Dandruff Shampoo (200 ml) — the complete ritual at a lower price than buying both separately.</p>"
          }
        }
      },
